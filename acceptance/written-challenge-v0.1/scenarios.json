  "requirements": [
    {
      "id": "WC01",
      "requirement": "Provide every required interaction, recovery step, and response in writing for the stipulated written-exchange need."
    },
    {
      "id": "WC02",
      "requirement": "Preserve exact drafts, explicit submission identity, and unconfirmed attempts across the stipulated pause; do not silently duplicate a submission."
    },
    {
      "id": "WC03",
      "requirement": "Preserve corrections and prior submitted text; bind review and response to the exact revision; do not treat an unsubmitted draft as submitted."
    },
    {
      "id": "WC04",
      "requirement": "Keep proposed review request, acceptance, review note, response, resolution proposal, and resolution record as separate observations."
    },
    {
      "id": "WC05",
      "requirement": "Keep inclusive timing, late recorded events, elapsed targets, and unavailable event evidence separate; corrections do not reset targets."
    },
    {
      "id": "WC06",
      "requirement": "Match the declared visible projection across normal output, errors, history, export, and repeated requests for the paired hidden contexts."
    },
    {
      "id": "WC07",
      "requirement": "Preserve written disagreement and correction after response or recorded resolution; do not infer agreement from silence."
    },
    {
      "id": "WC08",
      "requirement": "Emit no downstream action and establish no actual appointment, transfer of responsibility, or authority."
    },
    {
      "id": "WC09",
      "requirement": "Keep authored expectations, execution evidence, interaction review, professional interpretation, and permission to act as distinct judgments."
    }
  ],
